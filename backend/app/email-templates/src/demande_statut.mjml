<mjml>
  <mj-body background-color="#f4f5f7">
    <mj-section background-color="#ffffff" padding="40px 20px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" font-size="20px" font-family="Ubuntu, Helvetica, Arial, sans-serif" color="#333333" padding-bottom="10px">{{ project_name }}</mj-text>
        <mj-divider border-color="{{ statut_color }}" border-width="3px" padding="0 0 20px 0"></mj-divider>
        <mj-text align="center" font-size="18px" font-weight="bold" font-family="Arial, Helvetica, sans-serif" color="{{ statut_color }}" padding-bottom="6px">{{ statut_label }}</mj-text>
        <mj-text align="center" font-size="13px" font-family="Arial, Helvetica, sans-serif" color="#888888" padding-bottom="20px">Dossier {{ dossier_ref }} — {{ vehicule_label }}</mj-text>
        <mj-text align="left" font-size="16px" line-height="1.6" font-family="Arial, Helvetica, sans-serif" color="#555555">{{ message }}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 20px 40px 20px">
      <mj-column width="100%">
        <mj-button align="center" font-size="16px" background-color="#009688" border-radius="8px" color="#ffffff" href="{{ link }}" padding="10px 0">Accéder à mon espace</mj-button>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
