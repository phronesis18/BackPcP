# Modèle du fichier /opt/pcp/.env sur le serveur (secrets de production).
# Ne jamais committer le vrai fichier. Générer les secrets avec : openssl rand -hex 32

DOMAIN=phronesiscapital-partners.com
FRONTEND_HOST=https://phronesiscapital-partners.com
BACKEND_CORS_ORIGINS="https://phronesiscapital-partners.com,https://www.phronesiscapital-partners.com"
ENVIRONMENT=production

PROJECT_NAME="Phronesis Capital Partners"
SECRET_KEY=
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres (POSTGRES_SERVER est forcé à "db" par compose.yml)
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

SENTRY_DSN=
ANTHROPIC_API_KEY=
